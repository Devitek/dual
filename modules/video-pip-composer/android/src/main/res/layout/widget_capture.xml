<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_bg"
    android:padding="10dp"
    android:gravity="center_vertical">

  <ImageView
      android:id="@+id/widget_thumb"
      android:layout_width="54dp"
      android:layout_height="54dp"
      android:layout_marginEnd="8dp"
      android:scaleType="centerCrop"
      android:background="@drawable/widget_thumb_bg"
      android:src="@drawable/ic_tile_camera"
      android:contentDescription="@string/tile_capture_label" />

  <ImageView
      android:id="@+id/widget_btn_photo"
      android:layout_width="0dp"
      android:layout_height="48dp"
      android:layout_weight="1"
      android:padding="10dp"
      android:scaleType="fitCenter"
      android:src="@drawable/ic_tile_camera"
      android:contentDescription="@string/tile_capture_label" />

  <ImageView
      android:id="@+id/widget_btn_video"
      android:layout_width="0dp"
      android:layout_height="48dp"
      android:layout_weight="1"
      android:padding="10dp"
      android:scaleType="fitCenter"
      android:src="@drawable/ic_widget_video"
      android:contentDescription="@string/tile_capture_label" />

  <ImageView
      android:id="@+id/widget_btn_boom"
      android:layout_width="0dp"
      android:layout_height="48dp"
      android:layout_weight="1"
      android:padding="10dp"
      android:scaleType="fitCenter"
      android:src="@drawable/ic_widget_boom"
      android:contentDescription="@string/tile_capture_label" />
</LinearLayout>
