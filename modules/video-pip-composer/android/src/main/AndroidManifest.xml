<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission
    android:name="android.permission.WRITE_EXTERNAL_STORAGE"
    android:maxSdkVersion="28" />

  <!-- Visibilité de packages (Android 11+) pour le partage DIRECT vers ces apps.
       Packages spécifiques uniquement (jamais QUERY_ALL_PACKAGES) -> conforme Play. -->
  <queries>
    <package android:name="com.instagram.android" />
    <package android:name="com.zhiliaoapp.musically" />
    <package android:name="com.ss.android.ugc.trill" />
  </queries>

  <application>
    <service
      android:name="expo.modules.videopipcomposer.PipComposerService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />

    <!-- Tuile Réglages rapides « capture rapide » : ouvre l'app sur la caméra.
         Le système lie ce service (BIND_QUICK_SETTINGS_TILE) ; l'app ne demande
         AUCUNE permission sensible. -->
    <service
      android:name="expo.modules.videopipcomposer.CaptureTileService"
      android:exported="true"
      android:icon="@drawable/ic_tile_camera"
      android:label="@string/tile_capture_label"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
    </service>
  </application>

</manifest>
